VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Legacy Supabase anon key fallback; keep it public-only.
VITE_SUPABASE_ANON_KEY=replace_with_supabase_anon_key

# Server-side Supabase and Brevo credentials belong in Supabase secrets, never VITE_ variables.
# Required Supabase Edge Function secrets: BREVO_API_KEY, BREVO_SENDER_EMAIL,
# BREVO_SENDER_NAME, APP_ORIGINS. Supabase injects SUPABASE_URL and service credentials.
# Keep these blank here. Configure the SMTP values in Supabase Auth Custom SMTP settings.
SUPABASE_ACCESS_TOKEN=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MENYA Learning
APP_ORIGINS=http://localhost:5173
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
